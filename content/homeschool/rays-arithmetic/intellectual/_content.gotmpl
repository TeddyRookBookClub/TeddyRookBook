{{/* One page per lesson, from data/rays_intellectual.yaml (built by scripts/build_rays_intellectual.py) */}}
{{ $d := index site.Data "rays_intellectual" }}
{{ range $d.lessons }}
  {{ $.AddPage (dict
    "kind" "page"
    "path" (printf "lesson-%d" .num)
    "title" (printf "Lesson %d: %s" .num .title)
    "params" (dict "lesson" .num "description" (printf "How to teach Lesson %s of %s (1877), step by step: %s" .roman $d.book.title .goal))
    "dates" (dict "date" (time.AsTime "2026-10-10"))
  ) }}
{{ end }}
