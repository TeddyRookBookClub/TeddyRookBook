{{- /* Putnam solutions guide: one page per year file, data/comp/putnam/<year>.yaml -> /math/competitions/putnam/<year>/
   (layouts/comp/pyear.html). A new YAML file makes a new page. */ -}}
{{- $Y := (index ($.Site.Data.comp | default dict) "putnam") | default dict -}}
{{- range $k, $y := $Y -}}
  {{- $n := 0 }}{{ range $y.problems }}{{ if eq .status "ready" }}{{ $n = add $n 1 }}{{ end }}{{ end -}}
  {{- $desc := printf "Putnam %v: our own solutions (not official) to %d of the %d problems, with hints and animations, and a link to the official problems." $y.year $n (len ($y.problems | default slice)) -}}
  {{- $.AddPage (dict "path" (string $k) "kind" "page" "type" "comp" "layout" "pyear" "title" (printf "Putnam %v" $y.year) "description" $desc "params" (dict "year" (string $k))) -}}
{{- end -}}
