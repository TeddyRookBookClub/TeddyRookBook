{{- /* Tripos pages: one page per data file, data/comp/tripos/<file>.yaml -> /math/competitions/tripos/<slug>/
   (layouts/comp/tpaper.html, contest "tripos"). A new YAML file makes a new page. */ -}}
{{- $T := (index ($.Site.Data.comp | default dict) "tripos") | default dict -}}
{{- range $k, $y := $T -}}
  {{- $n := 0 }}{{ range $y.problems }}{{ if eq .status "ready" }}{{ $n = add $n 1 }}{{ end }}{{ end -}}
  {{- $what := cond (eq $y.kind "paper") (printf "the complete %s paper, %s, to take against the clock" (string $y.year) $y.date) "forty standout problems from 1801 to 1860" -}}
  {{- $desc := printf "Cambridge Mathematical Tripos: %s, in the examiners' own words, with our own hints and solutions (%d of %d ready)." $what $n (len ($y.problems | default slice)) -}}
  {{- $.AddPage (dict "path" (string ($y.slug | default $k)) "kind" "page" "type" "comp" "layout" "tpaper" "title" $y.title "description" $desc "params" (dict "tfile" (string $k) "contest" "tripos")) -}}
{{- end -}}
