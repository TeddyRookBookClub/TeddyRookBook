{{/* One page per lesson of the Plumbing course, from data/trades/plumbing.json. */}}
{{ $d := site.Data.trades.plumbing }}
{{ $date := time.AsTime "2026-10-14" }}
{{ range $d.lessons }}
  {{ $.AddPage (dict
    "type" "trades"
    "kind" "page"
    "path" .key
    "title" (printf "%s: How Plumbing Works, Lesson %d" .title (int .n))
    "params" (dict "course" "plumbing" "lesson" .key "description" (printf "Lesson %d of a free course on how plumbing works. %s" (int .n) .short))
    "dates" (dict "date" $date)
  ) }}
{{ end }}
