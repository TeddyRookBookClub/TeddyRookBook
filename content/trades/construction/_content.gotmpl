{{/* One page per lesson of the Construction course, from data/trades/construction.json. */}}
{{ $d := site.Data.trades.construction }}
{{ $date := time.AsTime "2026-10-14" }}
{{ range $d.lessons }}
  {{ $.AddPage (dict
    "type" "trades"
    "kind" "page"
    "path" .key
    "title" (printf "%s: How a House Is Built, Lesson %d" .title (int .n))
    "params" (dict "course" "construction" "lesson" .key "description" (printf "Lesson %d of a free course on how a house is built. %s" (int .n) .short))
    "dates" (dict "date" $date)
  ) }}
{{ end }}
